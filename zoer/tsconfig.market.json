{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "@bcbid/shared": ["packages/shared/src/index.ts"],
      "@bcbid/procurement-core": ["packages/procurement-core/src/index.ts"],
      "@bcbid/shared/*": ["packages/shared/src/*"],
      "@convex/_generated/api": ["zoer/dashboard/api.ts"],
      "@convex/*": ["convex/*"],
      "@zoer/plugin-ui/controls": ["../zoer/frontend/src/plugin-ui/controls.ts"],
      "@zoer/plugin-ui/analysis": ["../zoer/frontend/src/plugin-ui/analysis.ts"],
      "@zoer/plugin-ui/database": ["../zoer/frontend/src/plugin-ui/database.ts"],
      "@zoer/plugin-ui/button": ["../zoer/frontend/src/components/ui/Btn.tsx"],
      "@zoer/plugin-ui-host/controls": ["../zoer/frontend/src/plugin-ui/controls.ts"],
      "@zoer/plugin-ui-host/analysis": ["../zoer/frontend/src/plugin-ui/analysis.ts"],
      "@zoer/plugin-ui-host/database": ["../zoer/frontend/src/plugin-ui/database.ts"],
      "@zoer/plugin-ui-host/button": ["../zoer/frontend/src/components/ui/Btn.tsx"],
      "@zoer/api-types": ["../zoer/packages/api-types/src/index.ts"],
      "@tanstack/react-query": ["../zoer/frontend/node_modules/@tanstack/react-query"]
    }
  },
  "include": ["dashboard/market/**/*.ts", "dashboard/market/**/*.tsx"]
}
