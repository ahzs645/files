      {
        "id": "procurement.collect",
        "title": "Collect CanadaBuys tenders",
        "description": "Fetch the official federal open-tender CSV and merge bounded batches into the existing catalog. Resume checks the source checksum; no saved notices are deleted.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "artifact-store",
          "network-egress"
        ],
        "resourceLimits": {
          "timeoutMs": 600000,
          "maxMemoryMb": 1024,
          "maxOutputBytes": 67108864,
          "maxNetworkRequests": 1,
          "maxNetworkResponseBytes": 20971520
        },
        "idempotent": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceId": {
              "type": "string",
              "enum": [
                "canadabuys"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "resume",
                "restart"
              ],
              "default": "resume"
            },
            "maxBatches": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 1
            }
          },
          "required": [
            "sourceId"
          ]
        }
      },
      {
        "id": "procurement.alerts",
        "title": "Check saved procurement searches",
        "description": "Explicitly check saved searches and add deduplicated new-notice alerts. This does not enable a schedule.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "host-action",
          "handler": "procurement.alerts.v1"
        },
        "requiredCapabilities": [
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 1024,
          "maxOutputBytes": 67108864
