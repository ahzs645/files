        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      {
        "id": "procurement.state",
        "title": "Save procurement workflow state",
        "description": "Version-checked saved search and pursuit changes in the existing workspace catalog.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 1024,
          "maxOutputBytes": 67108864
        },
        "idempotent": true,
        "inputSchema": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "pursuit.upsert"
                  ]
                },
                "expectedVersion": {
                  "type": "integer",
