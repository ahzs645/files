{
  "id": "bc-bid-monitor",
  "name": "Procurement",
  "version": "0.25.0",
  "description": "Multi-source procurement catalog with BC Bid, CanadaBuys collection, saved searches, pursuits and source-aware analysis.",
  "type": "integration",
  "integration": {
    "apiVersion": "1",
    "networkAllowlist": [
      "bcbid.gov.bc.ca",
      "canadabuys.canada.ca"
    ],
    "permissions": [
      "browser:page:read",
      "artifacts:write",
      "workspace:sandbox",
      "workspace:native",
      "browser:pages:capture",
      "browser:search",
      "workspace:downloads",
      "workspace:catalog"
    ],
    "workspace": {
      "title": "Procurement",
      "icon": "puzzle",
      "surfaceIds": [
        "opportunities",
        "details"
      ],
      "entrypoint": "dashboard/index.html",
      "native": {
        "module": "native/index.js",
        "style": "native/style.css"
      }
    },
    "actions": [
      {
        "id": "browser.open",
        "title": "Open BC Bid opportunities",
        "description": "Navigate the selected Zoer browser to public opportunities. Browser checks remain manual.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "browser-session",
          "handler": "browser.navigate.v1"
        },
        "requiredCapabilities": [
          "browser-session"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "enum": [
                "https://bcbid.gov.bc.ca/page.aspx/en/rfp/request_browse_public"
              ],
              "default": "https://bcbid.gov.bc.ca/page.aspx/en/rfp/request_browse_public"
            }
          },
          "required": [
            "url"
          ]
        },
        "resourceLimits": {
          "timeoutMs": 45000,
          "maxOutputBytes": 65536
        },
        "idempotent": true
      },
      {
        "id": "listing.capture",
        "title": "Capture current listing page",
        "description": "Parse only the current BC Bid public page and save records in the database. Complete browser checks manually. This does not crawl other pages.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "browser-session",
          "artifact-store"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "opportunity_id": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "status": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "type": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "closing_date": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "issued_by": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "detail_url": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "opportunity_id",
                  "description",
                  "status",
                  "type",
                  "closing_date",
                  "issued_by",
                  "detail_url"
                ]
              }
            },
            "artifactId": {
              "type": "string"
            },
            "sourceUrl": {
              "type": "string"
            },
            "capturedAt": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "current-page"
              ]
            }
          },
          "required": [
            "rows",
            "artifactId",
            "sourceUrl",
            "capturedAt",
            "scope"
          ]
        },
        "resourceLimits": {
          "timeoutMs": 90000,
          "maxMemoryMb": 256,
          "maxOutputBytes": 2097152
        },
        "idempotent": false
      },
      {
        "id": "detail.capture",
        "title": "Capture current detail page",
        "description": "Parse only the current BC Bid public page and save records in the database. Complete browser checks manually. This does not crawl other pages.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "browser-session",
          "artifact-store"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "field",
                  "value"
                ]
              }
            },
            "artifactId": {
              "type": "string"
            },
            "sourceUrl": {
              "type": "string"
            },
            "capturedAt": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "current-page"
              ]
            }
          },
          "required": [
            "rows",
            "artifactId",
            "sourceUrl",
            "capturedAt",
            "scope"
          ]
        },
        "resourceLimits": {
          "timeoutMs": 90000,
          "maxMemoryMb": 256,
          "maxOutputBytes": 2097152
        },
        "idempotent": false
      },
      {
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "browser-session",
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 256,
          "maxOutputBytes": 2097152,
          "maxBrowserPages": 4
        },
        "idempotent": false,
        "id": "scrape.sample",
        "title": "Scrape a listing page and details",
        "description": "Capture the first public listing page and up to three opportunity details. Saves checkpoints in Zoer; browser checks require manual completion. Additional listing pages are not crawled.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detailLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 3
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "listingCount": {
              "type": "integer"
            },
            "detailCount": {
              "type": "integer"
            },
            "pageCount": {
              "type": "integer"
            },
            "scope": {
              "type": "string"
            },
            "limited": {
              "type": "boolean"
            },
            "totalPages": {
              "type": "integer"
            }
          },
          "required": [
            "artifactId",
            "listingCount",
            "detailCount",
            "pageCount",
            "scope",
            "limited",
            "totalPages"
          ]
        }
      },
      {
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 256,
          "maxOutputBytes": 2097152
        },
        "idempotent": false,
