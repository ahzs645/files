                  },
                  "opportunityDescription": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "opportunityType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "issuingOrganization": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "issuingLocation": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "contractNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "contactEmail": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "contractValueText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "successfulSupplier": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "supplierAddress": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "awardDate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  },
                  "justification": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20000
                  }
                },
                "required": [
                  "opportunityId",
                  "opportunityDescription",
                  "opportunityType",
                  "issuingOrganization",
                  "issuingLocation",
                  "contractNumber",
                  "contactEmail",
                  "contractValueText",
                  "currency",
                  "successfulSupplier",
                  "supplierAddress",
                  "awardDate",
                  "justification"
                ]
              }
            }
          },
          "required": [
            "records",
            "fileName"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            }
          },
          "required": [
            "artifactId",
            "count"
          ]
        }
      },
      {
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "requiredCapabilities": [
          "browser-session",
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 7200000,
          "maxMemoryMb": 512,
          "maxOutputBytes": 67108864,
          "maxBrowserPages": 8192
        },
        "idempotent": false,
        "id": "scrape.full",
        "title": "Scrape all current public opportunities",
        "description": "Crawl all current listing pages and opportunity details, saving attachment links and resumable checkpoints. Up to 200 listing pages, 3000 opportunities, two hours. Browser checks require manual completion.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resume": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "listingCount": {
              "type": "integer"
            },
            "detailCount": {
              "type": "integer"
            },
            "pageCount": {
              "type": "integer"
            },
            "scope": {
              "type": "string"
            },
            "limited": {
              "type": "boolean"
            },
            "totalPages": {
              "type": "integer"
            }
          },
          "required": [
            "artifactId",
            "listingCount",
            "detailCount",
            "pageCount",
            "scope",
            "limited",
            "totalPages"
          ]
        }
      },
      {
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "idempotent": false,
        "id": "awards.history",
        "title": "Download public award history",
        "description": "Backfill public awards in resumable date ranges, skipping completed ranges and unchanged records. Optionally refresh the last 30 days. Undated records are not verified; attachments are separate.",
        "requiredCapabilities": [
          "browser-session",
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 21600000,
          "maxMemoryMb": 512,
          "maxOutputBytes": 67108864,
          "maxBrowserPages": 8192
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resume": {
              "type": "object",
              "additionalProperties": true
            },
            "mode": {
              "type": "string",
              "enum": [
                "history",
                "recent"
              ]
            }
          }
        }
      },
      {
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/worker.js"
        },
        "idempotent": false,
        "id": "stars.set",
        "title": "Save bid star",
        "description": "Save or remove a star on an opportunity or award in Zoer.",
        "requiredCapabilities": [
          "artifact-store"
        ],
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 256,
          "maxOutputBytes": 262144
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity": {
              "type": "string",
              "enum": [
                "opportunity",
                "award"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "starred": {
              "type": "boolean"
            }
          },
          "required": [
            "entity",
            "key",
            "starred"
          ]
        }
      },
